{
  "xiaomi_mue4094rt.binary_sensor": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "device_class": {
              "default": "motion"
            },
            "id": {
              "id_type": {
                "class": "xiaomi_mue4094rt::XiaomiMUE4094RT",
                "parents": [
                  "binary_sensor::BinarySensor",
                  "EntityBase",
                  "Component",
                  "esp32_ble_tracker::ESPBTDeviceListener"
                ]
              }
            },
            "mac_address": {
              "key": "Required"
            },
            "timeout": {
              "default": "5s",
              "key": "Optional",
              "schema": {
                "extends": [
                  "core.positive_time_period_milliseconds"
                ]
              },
              "type": "schema"
            }
          },
          "extends": [
            "binary_sensor._BINARY_SENSOR_SCHEMA",
            "bthome_mithermometer.BLE_DEVICE_SCHEMA",
            "core.COMPONENT_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  }
}