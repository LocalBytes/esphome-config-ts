{
  "name": "esphome-config-ts",
  "version": "0.2.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./components": "./dist/components.mjs",
    "./generate": "./dist/generate.mjs",
    "./yaml": "./dist/yaml.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev:watch": "tsdown --watch",
    "prepare": "tsdown ./src/generator/generate.ts && node ./dist/generate.mjs && tsdown",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt ."
  },
  "dependencies": {
    "js-yaml": "^5.3.0",
    "unzipper": "^0.12.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.5",
    "@types/unzipper": "^0.10.11",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.83.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.2.1"
}
